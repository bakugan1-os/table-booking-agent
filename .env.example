# Telegram API credentials (https://my.telegram.org)
TG_API_ID=
TG_API_HASH=

# Telegram username of the manager to contact (without @)
MANAGER_USERNAME=

# LLM provider settings
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# The guest's own details, kept out of git.
# A facts file may override these; facts.yaml deliberately does not.
GUEST_NAME=
GUEST_PHONE=

# Speech to text for the manager's voice notes (Groq Whisper; the same Groq
# key works here). Leave empty and the agent asks them to write instead.
STT_BASE_URL=https://api.groq.com/openai/v1
STT_API_KEY=
STT_MODEL=whisper-large-v3

# Text to speech needs no key (edge-tts), but it does need ffmpeg on PATH.
# Optional: any Microsoft voice name, en-GB-SoniaNeural by default.
TTS_VOICE=

# Open the conversation with a voice note instead of a written message, and
# caption every voice note the agent sends. true/false, false by default;
# --voice-opening turns it on for one run.
VOICE_OPENING=false
